SUPABASE_URL=your_supabase_project_url
# Use the SERVICE_ROLE key here, not anon/public. This backend is a trusted
# server that already validates every request before writing — it should
# bypass table grants/RLS rather than needing them extended table-by-table
# as new features add writes (that's what caused the "permission denied for
# table consoles" 500 during the site-registration rollout). Get it from
# Supabase -> Project Settings -> API -> service_role (secret). Never put
# this in poc-frontend, never behind a VITE_ prefix, never committed — it
# has full read/write on every table with no restrictions.
SUPABASE_KEY=your_supabase_service_role_key
DATABASE_URL=your_supabase_postgres_connection_string

# OCR (console label serial/mfg-date extraction) runs entirely in the
# browser via Tesseract.js — no backend key, no cloud account, nothing to
# configure here.
